---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc></url>
  <url><loc>{{ '/journal/' | absolute_url }}</loc></url>
  {% assign pages = site.pages | where: "kind", "project" %}
  {% for item in pages %}<url><loc>{{ item.url | absolute_url }}</loc></url>{% endfor %}
  {% assign notes = site.pages | where: "kind", "note" %}
  {% for item in notes %}<url><loc>{{ item.url | absolute_url }}</loc></url>{% endfor %}
</urlset>
